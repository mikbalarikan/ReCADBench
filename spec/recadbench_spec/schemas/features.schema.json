{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recadbench/features/0.3.0",
  "title": "Extracted features (adapter output)",
  "type": "object",
  "required": [
    "tool",
    "native_file",
    "features",
    "count"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "description": "backend id"
    },
    "native_file": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "description": "Derived: number of features with counted=true. Validator checks consistency."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "native_type",
          "taxonomy_type",
          "counted"
        ],
        "properties": {
          "native_name": {
            "type": "string"
          },
          "native_type": {
            "type": "string"
          },
          "taxonomy_type": {
            "type": "string"
          },
          "counted": {
            "type": "boolean"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Native items that are not parametric features (dumb solids, raw kernel shapes, imported bodies). Non-empty ⇒ gate fail."
    },
    "native_sha256": {
      "type": "string"
    },
    "face_count": {
      "type": "integer"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "feature": {
            "type": "string"
          }
        }
      },
      "description": "Named/driving parameters found in the native model (for parametric-presence check)"
    },
    "not_in_final_part": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Traced native features that do not reach the final part (scratch / exploratory geometry). Informational: never counted, not unmapped."
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "native_type"
        ],
        "properties": {
          "native_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "native_type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Native items that are not in the model (suppressed / rolled back). Neither counted nor unmapped."
    },
    "final_part": {
      "type": "string",
      "description": "How the adapter identified the final part (e.g. the variable or body it used). Informational."
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "description": "Names of the solid bodies in the native model. Informational."
    }
  }
}