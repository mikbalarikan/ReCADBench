{
  "description": "ReCADBench conformance replay C05_rect_pattern: plate 60x40x`plate_t`; seed hole d=`hole_d` at (-20,-10); rectangular pattern of the seed feature 3 x 20 along +X, 2 x 20 along +Y",
  "ir": "backends/conformance/ir_cases/C05_rect_pattern/re_plan.v1.json",
  "commands": [
    {"command": "parameters.add", "params": {"name": "plate_t", "expression": "8 mm"}},
    {"command": "parameters.add", "params": {"name": "hole_d", "expression": "5 mm"}},
    {"command": "sketch.create", "params": {"plane": "XY"}},
    {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [30, 20]}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.extrude", "params": {"distance": "plate_t", "direction": "positive"}, "ir": "F1"},
    {"command": "solid.hole", "params": {"position": [-20, -10, "plate_t"], "diameter": "hole_d", "type": "simple"}, "ir": "F2"},
    {"command": "solid.pattern.rectangular", "params": {"features": ["Hole1"], "dir1": [1, 0, 0], "count1": 3, "spacing1": 20, "dir2": [0, 1, 0], "count2": 2, "spacing2": 20}, "ir": "F3"}
  ]
}
