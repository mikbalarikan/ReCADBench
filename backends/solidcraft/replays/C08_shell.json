    {"command": "solid.extrude", "params": {"distance": 20, "direction": "positive"}, "ir": "F1"},
    {"command": "solid.shell", "params": {"faces": [[0, 0, 20]], "thickness": "wall_t", "direction": "inside"}, "ir": "F2"}
  ]
}
