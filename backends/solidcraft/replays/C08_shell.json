{
  "description": "ReCADBench conformance replay C08_shell: block 40x30x20 shelled inward by `wall_t`, top face removed",
  "ir": "backends/conformance/ir_cases/C08_shell/re_plan.v1.json",
  "commands": [
    {"command": "parameters.add", "params": {"name": "wall_t", "expression": "2 mm"}},
    {"command": "sketch.create", "params": {"plane": "XY"}},
